# Klip Cloud settings. Copy to /etc/klip-cloud.env, fill in, keep it readable by root only.

# Where the server listens. nginx forwards to it, so it stays on localhost.
KLIP_PORT=3160
KLIP_HOST=127.0.0.1

# Public address including the path, without a slash at the end.
KLIP_BASE_URL=https://imkirit.dev/klip/cloud

# Database and clips stored on the server.
KLIP_DATA_DIR=/var/lib/klip-cloud

# Discord application (discord.com/developers/applications, OAuth2).
# Redirect: <KLIP_BASE_URL>/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional: Google Drive as storage (console.cloud.google.com, OAuth client "Web application",
# Drive API enabled). Redirect: <KLIP_BASE_URL>/auth/google/callback. Empty turns Drive off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Space per account on the server disk in GB (0 means no limit) and the largest single clip in MB.
KLIP_QUOTA_GB=20
KLIP_MAX_UPLOAD_MB=2048

# Comma separated Discord user ids that may sign in. Empty means every Discord account.
KLIP_ALLOWED_DISCORD_IDS=
